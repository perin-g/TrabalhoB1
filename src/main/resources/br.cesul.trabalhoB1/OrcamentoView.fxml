<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.cesul.trabalhoB1.view.OrcamentoView">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="600.0">
         <top>
            <HBox prefHeight="47.0" prefWidth="600.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox alignment="TOP_CENTER" prefHeight="56.0" prefWidth="590.0" spacing="5.0">
                     <children>
                        <Label fx:id="totalLbl" alignment="CENTER" contentDisplay="CENTER" prefHeight="33.0" prefWidth="190.0" text="TOTAL DO MÊS R$: 0,00">
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets left="5.0" right="5.0" top="5.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>
         </top>
         <center>
            <HBox prefHeight="351.0" prefWidth="600.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox alignment="TOP_CENTER" prefHeight="129.0" prefWidth="604.0" spacing="5.0">
                     <children>
                        <Label text="Descrição">
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="descField">
                           <VBox.margin>
                              <Insets left="20.0" right="20.0" />
                           </VBox.margin>
                        </TextField>
                        <Label text="Valor">
                           <VBox.margin>
                              <Insets top="20.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="valorField" prefHeight="25.0" prefWidth="181.0">
                           <VBox.margin>
                              <Insets left="20.0" right="20.0" />
                           </VBox.margin>
                        </TextField>
                        <Label text="Data">
                           <VBox.margin>
                              <Insets top="20.0" />
                           </VBox.margin>
                        </Label>
                        <DatePicker fx:id="datePicker" prefHeight="25.0" prefWidth="207.0" />
                        <Button fx:id="addButton" mnemonicParsing="false" text="Inserir">
                           <VBox.margin>
                              <Insets top="20.0" />
                           </VBox.margin>
                        </Button>
                        <Button fx:id="deleteButton" mnemonicParsing="false" text="Deletar">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </VBox>
                  <TableView fx:id="orcamentoTable" prefHeight="300.0" prefWidth="714.0">
                    <columns>
                      <TableColumn fx:id="descCol" prefWidth="75.0" text="Descrição" />
                      <TableColumn fx:id="valorCol" prefWidth="75.0" text="Valor" />
                        <TableColumn fx:id="dataColumn" prefWidth="75.0" text="Data" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <HBox.margin>
                        <Insets bottom="10.0" right="10.0" />
                     </HBox.margin>
                  </TableView>
               </children>
            </HBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
